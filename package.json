{
  "name": "learn-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "bundle": "node scripts/bundle-feature.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:db": "node --import tsx --test database/tests/*.test.ts",
    "test:e2e": "node --import tsx --test --test-concurrency=1 tests/e2e/*.e2e.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@recharts/devtools": "^0.0.14",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "bwip-js": "^4.11.4",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.2.0",
    "jose": "^6.2.10",
    "next": "^16.3.8",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-barcode": "^1.6.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.85.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-to-print": "^3.3.0",
    "recharts": "^3.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
