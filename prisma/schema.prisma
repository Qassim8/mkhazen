generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
}

model Product {
  id               String   @id @default(cuid())
  title            String
  description      String
  sku              String   @unique
  thumbnail        String
  images           String[]
  in_stock         Boolean
  quantity         Int
  unit             String
  selling_price    Float
  purchase_price   Float
  warning_quantity Int
  sizes            String[]
}
